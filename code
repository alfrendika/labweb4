<script>
  // Navigasi antar halaman (tanpa reload)
  function showPage() {
    var id = (location.hash || '#home').substring(1);
    if (!document.getElementById(id)) id = 'home';
    document.querySelectorAll('.page').forEach(function (p) { p.classList.toggle('active', p.id === id); });
    document.querySelectorAll('nav a').forEach(function (a) { a.classList.toggle('active', a.getAttribute('href') === '#' + id); });
    window.scrollTo(0, 0);
  }
  window.addEventListener('hashchange', showPage);
  showPage();
</script>
