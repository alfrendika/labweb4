<style>
@import url('https://fonts.googleapis.com/css2?family=Open+Sans:wght@300;400;600;700;800&display=swap');

* { margin: 0; padding: 0; }
body { line-height: 1; font-size: 100%; font-family: 'Open Sans', sans-serif; color: #5a5a5a; }
#container { width: 980px; margin: 0 auto; box-shadow: 0 0 1em #ccc; }

/* header & nav */
header { padding: 20px; }
header h1 { margin: 20px 10px; color: #b5b5b5; }
nav { display: block; background-color: #1f5faa; }
nav a { padding: 15px 30px; display: inline-block; color: #fff; font-size: 14px; text-decoration: none; font-weight: bold; }
nav a.active, nav a:hover { background-color: #2b83ea; }

/* hero */
#hero, .hero { background-color: #e4e4e5; padding: 50px 20px; margin-bottom: 20px; }
.hero h1 { margin-bottom: 20px; font-size: 35px; }
.hero p { margin-bottom: 20px; font-size: 18px; line-height: 25px; }

/* tombol */
.btn { display: inline-block; padding: 8px 16px; border-radius: 3px; font-size: 14px; text-decoration: none; cursor: pointer; border: 0; font-family: inherit; }
.btn-large { padding: 12px 20px; background: #2b83ea; color: #fff; font-weight: bold; }
.btn-large:hover { background: #1f5faa; }
.btn-default { background: #bbb; color: #fff; }
.btn-default:hover { background: #999; }

/* main & sidebar (float) */
.main { float: left; width: 640px; padding: 20px; }
.sidebar { float: left; width: 260px; padding: 20px; }

/* widget */
.widget-box { border: 1px solid #eee; margin-bottom: 20px; }
.widget-box .title { padding: 10px 16px; background: #428bca; color: #fff; }
.widget-box ul { list-style: none; }
.widget-box li { border-bottom: 1px solid #eee; }
.widget-box li a { padding: 10px 16px; color: #333; display: block; text-decoration: none; }
.widget-box li:hover a { background: #eee; }
.widget-box p { padding: 15px; line-height: 25px; }

/* footer */
footer { clear: both; background: #1d1d1d; padding: 20px; color: #eee; }

/* box 3 kolom */
.box { display: block; float: left; width: 33.333333%; box-sizing: border-box; padding: 0 10px; text-align: center; }
.box h3 { margin: 15px 0; }
.box p { line-height: 20px; font-size: 14px; margin-bottom: 15px; }
.image-circle { border-radius: 50%; }
.row { margin: 0 -10px; box-sizing: border-box; }
.row:before, .row:after, .entry:before, .entry:after { content: ''; display: table; }
.row:after, .entry:after { clear: both; }
.divider { border: 0; border-top: 1px solid #eee; margin: 40px 0; }

/* entry */
.entry { margin: 15px 0; }
.entry h2 { margin-bottom: 20px; }
.entry p { line-height: 25px; margin-bottom: 10px; }
.entry img { float: left; border-radius: 5px; margin-right: 15px; }
.entry .right-img { float: right; margin-right: 0; margin-left: 15px; }
.entry .about-photo { width: 150px; height: 150px; object-fit: cover; border-radius: 50%; margin: 0 20px 10px 0; }

/* about */
.page-title { font-size: 26px; margin-bottom: 20px; }
.skill-list { list-style: none; margin: 15px 0; overflow: hidden; }
.skill-list li { float: left; background: #1f5faa; color: #fff; font-size: 13px; padding: 6px 12px; border-radius: 3px; margin: 0 8px 8px 0; }
.portfolio-item { float: left; width: 50%; box-sizing: border-box; padding: 0 10px; margin-bottom: 20px; }
.portfolio-item img { width: 100%; height: auto; border-radius: 5px; display: block; }
.portfolio-item h4 { margin: 10px 0 5px; }
.portfolio-item p { font-size: 14px; line-height: 20px; }

/* form kontak */
.contact-form .form-group { margin-bottom: 18px; }
.contact-form label { display: block; font-weight: 600; margin-bottom: 6px; font-size: 14px; }
.contact-form input[type="text"], .contact-form input[type="email"], .contact-form select, .contact-form textarea {
  width: 100%; box-sizing: border-box; padding: 10px 12px; border: 1px solid #ccc; border-radius: 3px; font-family: inherit; font-size: 14px; color: #5a5a5a; }
.contact-form input:focus, .contact-form select:focus, .contact-form textarea:focus { outline: none; border-color: #2b83ea; box-shadow: 0 0 4px rgba(43,131,234,.4); }
.contact-form textarea { resize: vertical; }
.contact-form .btn { margin-right: 8px; }

/* ganti halaman */
.page { display: none; }
.page.active { display: block; }
.page:after { content: ''; display: table; clear: both; }
</style>
</head>
